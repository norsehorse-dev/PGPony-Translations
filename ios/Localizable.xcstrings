    "Need a full fingerprint (40 hex characters) or a 16-character key ID. \"%@\" is %lld characters." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erforderlich ist ein vollständiger Fingerabdruck (40 Hexadezimalzeichen) oder eine 16-stellige Schlüssel-ID. „%@\" hat %lld Zeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Need a full fingerprint (40 hex characters) or a 16-character key ID. \"%@\" is %lld characters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita una huella digital completa (40 caracteres hexadecimales) o un ID de clave de 16 caracteres. «%@» tiene %lld caracteres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut une empreinte complète (40 caractères hexadécimaux) ou un ID de clé de 16 caractères. « %@ » compte %lld caractères."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全なフィンガープリント（16 進 40 文字）または 16 文字の鍵 ID が必要です。「%@」は %lld 文字です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "40 자의 전체 지문이나 16 자의 키 ID가 필요합니다. \"%@\"는 %lld 자입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É necessária uma impressão digital completa (40 caracteres hexadecimais) ou um ID de chave de 16 caracteres. \"%@\" tem %lld caracteres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужен полный отпечаток (40 шестнадцатеричных символов) или 16-символьный идентификатор ключа. «%@» содержит %lld символов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要完整的指纹（40 位十六进制字符）或 16 位密钥 ID。\"%@\" 只有 %lld 个字符。"
          }
        }
      }
    },
