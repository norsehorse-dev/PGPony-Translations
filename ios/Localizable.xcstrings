    },
    "Card erased to factory defaults. Its keys are gone — you may want to unlink this key from your keyring." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte auf Werkseinstellungen zurückgesetzt. Ihre Schlüssel sind weg — du solltest diesen Schlüssel eventuell aus deinem Schlüsselbund entkoppeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card erased to factory defaults. Its keys are gone — you may want to unlink this key from your keyring."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarjeta restablecida a los valores de fábrica. Sus claves ya no existen; quizá quieras desvincular esta clave de tu llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carte réinitialisée aux réglages d'usine. Ses clés ont disparu — vous pouvez dissocier cette clé de votre trousseau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードを工場出荷時の状態に消去しました。カード上の鍵は失われました。鍵束からこの鍵の関連付けを解除することをおすすめします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드가 공장 초기화되었습니다. 키가 모두 사라졌으니 키링에서 이 키 연결을 해제하는 것이 좋습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartão apagado para os padrões de fábrica. Suas chaves se foram — talvez você queira desvincular esta chave do seu chaveiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта сброшена до заводских настроек. Ключи на карте так же удалены - вы можете отвязать этот ключ от вашей связки ключей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡已擦除并恢复出厂默认值。卡上的密钥已不存在——你可能需要从密钥环中取消关联此密钥。"
          }
        }
      }
    },
