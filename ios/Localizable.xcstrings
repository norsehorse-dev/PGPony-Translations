    "Leave the key plugged in for the whole operation — it generates two key pairs and two signatures in one session." : {
      "comment" : "Alert message describing the NFC/USB operation of generating a key on a card.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass den Schlüssel während des gesamten Vorgangs angeschlossen — er erzeugt zwei Schlüsselpaare und zwei Signaturen in einer Sitzung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja la clave conectada durante toda la operación — genera dos pares de claves y dos firmas en una sola sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez la clé branchée pendant toute l'opération — elle génère deux paires de clés et deux signatures en une seule session."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作が終わるまでキーを接続したままにしてください。1回のセッションで2組の鍵ペアと2つの署名を生成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업 내내 키를 꽂아 두세요 — 한 번의 세션에서 키쌍 두 개와 서명 두 개를 만듭니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe a chave conectada durante toda a operação — ela gera dois pares de chaves e duas assinaturas em uma única sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вынимайте ключ на протяжении всей операции — за один сеанс он сгенерирует две пары ключей и две подписи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在整个操作期间请保持密钥插入——它会在一次会话中生成两对密钥和两个签名。"
          }
        }
      }
    },
