    "Some keys couldn’t be restored — they may be malformed. The rest were restored." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Schlüssel konnten nicht wiederhergestellt werden – sie sind möglicherweise fehlerhaft. Der Rest wurde wiederhergestellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas claves no se pudieron restaurar; puede que estén dañadas. El resto se restauró."
