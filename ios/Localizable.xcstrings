      }
    },
    "That file is %@. The share sheet can handle up to %@ — open PGPony directly for larger files." : {
      "comment" : "A warning when a file is too large to share.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei ist %1$@. Das Teilen-Menü kann bis zu %2$@ verarbeiten — öffne PGPony direkt für größere Dateien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That file is %1$@. The share sheet can handle up to %2$@ — open PGPony directly for larger files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese archivo es de %1$@. La hoja de compartir admite hasta %2$@ — abre PGPony directamente para archivos más grandes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier fait %1$@. La feuille de partage peut gérer jusqu'à %2$@ — ouvrez PGPony directement pour les fichiers plus volumineux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは%1$@です。共有シートで扱えるのは%2$@までです。それより大きいファイルはPGPonyを直接開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 파일은 %1$@입니다. 공유 시트는 최대 %2$@까지 처리할 수 있습니다 — 더 큰 파일은 PGPony를 직접 여세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse arquivo tem %1$@. A folha de compartilhamento suporta até %2$@ — abra o PGPony diretamente para arquivos maiores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот файл — %1$@. Общий доступ поддерживает до %2$@ — для файлов большего размера открывайте PGPony напрямую."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该文件为 %1$@。分享面板最多可处理 %2$@——更大的文件请直接打开 PGPony。"
          }
        }
      }
    },
    "That file is %@. This operation needs the whole file in memory, which PGPony caps at %@. Encrypting and decrypting files from the file picker has no such limit." : {
      "comment" : "A warning message that a file is too large to open. The first argument is the size of the file. The second argument is the size limit.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei ist %1$@. Dieser Vorgang benötigt die gesamte Datei im Speicher, was PGPony auf %2$@ begrenzt. Beim Verschlüsseln und Entschlüsseln von Dateien aus der Dateiauswahl gibt es keine solche Grenze."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That file is %1$@. This operation needs the whole file in memory, which PGPony caps at %2$@. Encrypting and decrypting files from the file picker has no such limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese archivo es de %1$@. Esta operación necesita todo el archivo en memoria, que PGPony limita a %2$@. Cifrar y descifrar archivos desde el selector de archivos no tiene ese límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier fait %1$@. Cette opération nécessite le fichier entier en mémoire, ce que PGPony plafonne à %2$@. Le chiffrement et le déchiffrement de fichiers depuis le sélecteur de fichiers n'ont pas cette limite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは%1$@です。この操作はファイル全体をメモリに読み込む必要があり、PGPonyは%2$@に制限しています。ファイルピッカーからの暗号化と復号にはこの制限はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 파일은 %1$@입니다. 이 작업은 파일 전체를 메모리에 올려야 하며, PGPony는 %2$@까지 허용합니다. 파일 선택기에서 파일을 암호화하고 복호화하는 데는 이 제한이 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse arquivo tem %1$@. Esta operação precisa do arquivo inteiro na memória, o que o PGPony limita a %2$@. Criptografar e descriptografar arquivos pelo seletor de arquivos não tem esse limite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот файл — %1$@. Для этой операции требуется, чтобы весь файл находился в памяти, а объем памяти, поддерживаемый PGPony, ограничен %2$@. При шифровании и расшифровке файлов из списка файлов такого ограничения нет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
