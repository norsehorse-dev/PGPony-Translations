    "User ID editing supports Ed25519 software keys. For RSA keys, use GnuPG." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bearbeitung von Benutzer-IDs unterstützt Ed25519-Softwareschlüssel. Verwende für RSA-Schlüssel GnuPG."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La edición de IDs de usuario admite claves de software Ed25519. Para claves RSA, usa GnuPG."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modification des identifiants utilisateur prend en charge les clés logicielles Ed25519. Pour les clés RSA, utilisez GnuPG."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザー ID の編集は Ed25519 ソフトウェア鍵に対応しています。RSA 鍵には GnuPG を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 ID 편집은 Ed25519 소프트웨어 키를 지원합니다. RSA 키는 GnuPG를 쓰세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A edição de IDs de usuário é compatível com chaves de software Ed25519. Para chaves RSA, use o GnuPG."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редактирование идентификаторов пользователя поддерживает программные ключи Ed25519. Для ключей RSA используйте GnuPG."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用户 ID 编辑支持 Ed25519 软件密钥。RSA 密钥请使用 GnuPG。"
          }
        }
      }
    },
