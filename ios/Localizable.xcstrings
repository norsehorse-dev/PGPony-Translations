    "Uses Ed25519 + Curve25519 with a 2-year expiration. You can generate more keys with different settings later from the Keyring tab." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet Ed25519 + Curve25519 mit zweijähriger Gültigkeit. Du kannst später im Tab „Schlüsselbund“ weitere Schlüssel mit anderen Einstellungen erzeugen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses Ed25519 + Curve25519 with a 2-year expiration. You can generate more keys with different settings later from the Keyring tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Ed25519 + Curve25519 con caducidad de 2 años. Puedes generar más claves con otros ajustes desde la pestaña Llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise Ed25519 + Curve25519 avec une expiration de 2 ans. Vous pourrez générer d'autres clés avec des réglages différents depuis l'onglet Trousseau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ed25519 + Curve25519 を使用し、有効期限は 2 年間です。後から「鍵束」タブで別の設定の鍵を追加で作成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ed25519 + Curve25519을 쓰며 2년 후 만료됩니다. 나중에 키링 탭에서 다른 설정의 키를 더 만들 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Ed25519 + Curve25519 com expiração de 2 anos. Você pode gerar mais chaves com outras configurações depois pelo Chaveiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует Ed25519 + Curve25519 со сроком действия 2 года. Позже вы можете создать больше ключей с другими настройками во вкладке «Связка ключей»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Ed25519 + Curve25519，有效期为 2 年。之后你可以在密钥环标签页用不同设置生成更多密钥。"
          }
        }
      }
    },
