        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiffrer et signer avec une clé matérielle prend en charge les destinataires Curve25519 et RSA. %@ utilise un type de clé qui doit être chiffré séparément."
          }
        },
        "ja" : {
          "stringUnit" : {
