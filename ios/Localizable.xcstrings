    "Connect it to the USB-C port. Lightning keys such as the 5Ci are not supported." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe ihn an den USB-C-Anschluss an. Lightning-Schlüssel wie der 5Ci werden nicht unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctala al puerto USB-C. Las claves Lightning como la 5Ci no son compatibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branchez-la sur le port USB-C. Les clés Lightning telles que la 5Ci ne sont pas prises en charge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-Cポートに接続してください。5CiなどのLightningキーは非対応です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C 포트에 연결하세요. 5Ci 같은 Lightning 키는 지원하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte-a à porta USB-C. Chaves Lightning como a 5Ci não são suportadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите его к порту USB-C. Ключи с разъёмом Lightning, например 5Ci, не поддерживаются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
