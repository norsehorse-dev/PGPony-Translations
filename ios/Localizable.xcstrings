    "ASCII Armor Output" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ASCII-gehärtete Ausgabe"
          }
        },
        "en" : {
          "stringUnit" : {
