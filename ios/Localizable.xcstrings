    "Saved to PGPony. Open the PGPony app — or tap the notification — to finish decrypting on your hardware key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In PGPony gesichert. Öffne die PGPony-App — oder tippe auf die Mitteilung —, um die Entschlüsselung auf deinem Hardware-Schlüssel abzuschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved to PGPony. Open the PGPony app — or tap the notification — to finish decrypting on your hardware key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado en PGPony. Abre la app PGPony, o toca la notificación, para terminar de descifrar en tu llave de hardware."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré dans PGPony. Ouvrez l'app PGPony — ou touchez la notification — pour terminer le déchiffrement sur votre clé matérielle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PGPony に保存しました。PGPony App を開くか通知をタップして、ハードウェアキーでの復号を完了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PGPony에 저장했습니다. PGPony 앱을 열거나 — 알림을 눌러 — 하드웨어 키에서 복호화를 마치세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo no PGPony. Abra o app PGPony — ou toque na notificação — para concluir a decifração na sua chave de hardware."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранено в PGPony. Откройте приложение PGPony — или коснитесь уведомления — чтобы завершить расшифровку на вашем аппаратном ключе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存到 PGPony。打开 PGPony App——或轻点通知——以完成在硬件密钥上的解密。"
          }
        }
      }
    },
