    "You'll need this passphrase each time you decrypt. If you forget it, the key is permanently inaccessible." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchst diese Passphrase bei jeder Entschlüsselung. Wenn du sie vergisst, ist der Schlüssel dauerhaft unzugänglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll need this passphrase each time you decrypt. If you forget it, the key is permanently inaccessible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitarás esta frase de contraseña cada vez que descifres. Si la olvidas, la clave queda inaccesible para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
