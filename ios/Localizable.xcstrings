    "You will lose access to all encrypted messages that use these keys. There is no recovery." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verlierst den Zugriff auf alle verschlüsselten Nachrichten, die diese Schlüssel verwenden. Eine Wiederherstellung ist nicht möglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
