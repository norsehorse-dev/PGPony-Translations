          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用硬件密钥进行加密并签名仅支持 Curve25519 和 RSA 收件人。%@ 使用的是必须单独加密的密钥类型。"
          }
        }
      }
    },
