        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encoste sua chave de hardware OpenPGP (ex.: seu Token2) no topo do iPhone. O PGPony a vincula à chave pública correspondente no seu chaveiro para que você possa assinar e decifrar no cartão."
          }
        },
        "ru" : {
          "stringUnit" : {
