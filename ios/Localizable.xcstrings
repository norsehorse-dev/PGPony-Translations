        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот файл имеет размер %@, что намного больше, чем размер любого ключа или резервной копии. PGPony его не открыл."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
