    "That file is %@, which is far larger than any key or backup. PGPony didn't open it." : {
      "comment" : "A description of an error that might occur when opening a file.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
