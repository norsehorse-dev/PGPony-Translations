          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 키쌍이 만들어져 안전하게 저장되었습니다. 이제 메시지를 암호화하고 복호화하는 데 쓸 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
