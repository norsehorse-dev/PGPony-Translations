    "Encrypt text to a recipient in your keyring. Encryption uses the recipient's public key, so no passphrase is needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsselt Text an einen Empfänger in Ihrem Schlüsselbund. Die Verschlüsselung nutzt den öffentlichen Schlüssel des Empfängers, es ist also keine Passphrase nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cifra texto para un destinatario de tu llavero. El cifrado usa la clave pública del destinatario, así que no hace falta contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiffre du texte pour un destinataire de votre trousseau. Le chiffrement utilise la clé publique du destinataire, aucune phrase secrète n'est nécessaire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーリング内の受信者宛にテキストを暗号化します。暗号化には受信者の公開鍵を使うため、パスフレーズは不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키링의 받는 사람에게 텍스트를 암호화합니다. 암호화에는 받는 사람의 공개 키를 쓰므로 비밀구절이 필요 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criptografa texto para um destinatário do seu chaveiro. A criptografia usa a chave pública do destinatário, então não é necessária senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зашифруйте текст для получателя из вашей связки ключей. Шифрование использует публичный ключ получателя, поэтому парольная фраза не требуется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将文本加密给你密钥环中的收件人。加密使用收件人的公钥，因此无需密码。"
          }
        }
      }
    },
    "Encrypt-and-sign with a hardware key needs Curve25519 or RSA recipient keys. Sign separately, or choose different recipients." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschlüsseln und Signieren mit einem Hardware-Schlüssel erfordert Curve25519- oder RSA-Empfängerschlüssel. Signiere separat oder wähle andere Empfänger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encrypt-and-sign with a hardware key needs Curve25519 or RSA recipient keys. Sign separately, or choose different recipients."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cifrar y firmar con una llave de hardware requiere claves de destinatario Curve25519 o RSA. Firma por separado o elige otros destinatarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiffrer et signer avec une clé matérielle nécessite des clés de destinataire Curve25519 ou RSA. Signez séparément ou choisissez d'autres destinataires."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハードウェアキーでの暗号化と署名には Curve25519 または RSA の宛先鍵が必要です。別々に署名するか、別の宛先を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하드웨어 키로 암호화·서명하려면 Curve25519 또는 RSA 받는 사람 키가 필요합니다. 따로 서명하거나 다른 받는 사람을 고르세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cifrar e assinar com uma chave de hardware exige chaves de destinatário Curve25519 ou RSA. Assine separadamente ou escolha outros destinatários."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шифрование с подписью аппаратным ключом требует ключей получателей Curve25519 или RSA. Подпишите отдельно или выберите других получателей."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用硬件密钥进行加密并签名需要 Curve25519 或 RSA 收件人密钥。请单独签名，或选择其他收件人。"
          }
        }
      }
    },
    "Encrypt-and-sign with a hardware key supports Curve25519 and RSA recipients. %@ uses a key type that must be encrypted separately." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
