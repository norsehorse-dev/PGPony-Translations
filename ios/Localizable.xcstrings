    "Your new key pair has been created and stored securely. You can now use it to encrypt and decrypt messages." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein neues Schlüsselpaar wurde erstellt und sicher gespeichert. Du kannst es jetzt zum Verschlüsseln und Entschlüsseln von Nachrichten verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your new key pair has been created and stored securely. You can now use it to encrypt and decrypt messages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nuevo par de claves se ha creado y guardado de forma segura. Ya puedes usarlo para cifrar y descifrar mensajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre nouvelle paire de clés a été créée et stockée en toute sécurité. Vous pouvez maintenant l'utiliser pour chiffrer et déchiffrer des messages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
