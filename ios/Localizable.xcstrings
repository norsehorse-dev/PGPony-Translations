    },
    "The chosen key signs instead of this key when it matches the recipients. It must be a software key pair on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der gewählte Schlüssel signiert anstelle dieses Schlüssels, wenn er zu den Empfängern passt. Es muss ein Software-Schlüsselpaar auf diesem Gerät sein."
