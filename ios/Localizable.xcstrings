    },
    "Embedded in your public key. Use any name and email — they don't need to match a real account." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird in deinen öffentlichen Schlüssel eingebettet. Du kannst einen beliebigen Namen und eine beliebige E-Mail verwenden – sie müssen nicht zu einem echten Konto gehören."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Embedded in your public key. Use any name and email — they don't need to match a real account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se incorpora a tu clave pública. Puedes usar cualquier nombre y correo: no tienen que coincidir con una cuenta real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intégrés à votre clé publique. Utilisez n'importe quel nom et e-mail — ils n'ont pas besoin de correspondre à un compte réel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開鍵に埋め込まれます。実在するアカウントと一致させる必要はなく、好きな名前とメールを使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공개 키에 포함됩니다. 어떤 이름과 전자 우편 주소든 쓸 수 있습니다 — 실제 계정과 같지 않아도 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incorporados à sua chave pública. Use qualquer nome e e-mail — não precisam corresponder a uma conta real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Встроено в ваш публичный ключ. Используйте любое имя и эл. почту - они не обязательно должны соответствовать реальным данным."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嵌入在你的公钥中。可使用任意姓名和邮箱——它们不必对应真实账户。"
          }
        }
      }
    },
