    "Incorrect PIN. Only 1 attempt remains — if it fails, this key's PIN will be blocked. Double-check before trying again." : {
      "comment" : "Error message when the user has one attempt remaining to enter the PIN.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
