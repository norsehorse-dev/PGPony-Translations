    "RSA 4096-bit. Strong security, slower key generation. Best compatibility with all PGP tools." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 4096 Bit. Hohe Sicherheit, dafür langsamere Schlüsselerzeugung. Beste Kompatibilität mit allen PGP-Werkzeugen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 4096-bit. Strong security, slower key generation. Best compatibility with all PGP tools."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA de 4096 bits. Seguridad sólida, generación de claves más lenta. Mejor compatibilidad con todas las herramientas PGP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 4096 bits. Sécurité forte, génération de clés plus lente. Meilleure compatibilité avec tous les outils PGP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 4096 ビット。強力なセキュリティですが鍵生成は遅めです。すべての PGP ツールとの互換性が最も高いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 4096비트. 강한 보안, 느린 키 만들기. 모든 PGP 도구와 가장 호환됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA de 4096 bits. Segurança forte, geração de chave mais lenta. Melhor compatibilidade com todas as ferramentas PGP."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 4096-bit. Высокая безопасность, более медленное создание ключа. Наилучшая совместимость со всеми PGP-инструментами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 4096 位。安全性强，但密钥生成较慢。与所有 PGP 工具的兼容性最佳。"
          }
        }
      }
    },
