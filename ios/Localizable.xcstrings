        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 키들로 암호화된 모든 메시지에 접근할 수 없게 됩니다. 복구 방법은 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
