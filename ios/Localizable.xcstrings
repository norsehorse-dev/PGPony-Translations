    "Create unlimited key pairs for different identities — work, personal, projects. Free includes 1 key pair." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle unbegrenzt viele Schlüsselpaare für verschiedene Identitäten – beruflich, privat, projektbezogen. In der Gratisversion ist 1 Schlüsselpaar enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create unlimited key pairs for different identities — work, personal, projects. Free includes 1 key pair."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea pares de claves ilimitados para distintas identidades: trabajo, personal, proyectos. La versión gratis incluye 1 par de claves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un nombre illimité de paires de clés pour différentes identités — travail, personnel, projets. La version gratuite inclut 1 paire de clés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事、プライベート、プロジェクト用など、用途別に鍵ペアを無制限に作成できます。無料版では 1 ペアまで利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 신원에 쓸 키쌍을 제한 없이 만드세요 — 업무, 개인, 프로젝트. 무료 버전에는 키쌍 1 개가 포함됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
