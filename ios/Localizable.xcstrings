    "Files this large can't be signed with a hardware key yet. Use a smaller file, or sign with a software key." : {
      "comment" : "A message displayed when a file is too large to be signed with a hardware key.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So große Dateien können noch nicht mit einem Hardware-Schlüssel signiert werden. Verwende eine kleinere Datei oder signiere mit einem Software-Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos de este tamaño aún no se pueden firmar con una clave de hardware. Usa un archivo más pequeño o firma con una clave de software."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers de cette taille ne peuvent pas encore être signés avec une clé matérielle. Utilisez un fichier plus petit ou signez avec une clé logicielle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサイズのファイルはまだハードウェアキーで署名できません。より小さいファイルを使うか、ソフトウェアキーで署名してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이렇게 큰 파일은 아직 하드웨어 키로 서명할 수 없습니다. 더 작은 파일을 쓰거나 소프트웨어 키로 서명하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos deste tamanho ainda não podem ser assinados com uma chave de hardware. Use um arquivo menor ou assine com uma chave de software."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы такого размера пока нельзя подписать аппаратным ключом. Используйте файл поменьше или подпишите программным ключом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如此大的文件暂时无法用硬件密钥签名。请使用较小的文件，或用软件密钥签名。"
          }
        }
      }
