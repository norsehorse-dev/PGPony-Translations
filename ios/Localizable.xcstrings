    "The card connection dropped before the operation finished. Check the key is firmly in the USB-C port and try again." : {
      "comment" : "Text displayed in a warning banner at the top of the screen when the connection to the card is lost.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kartenverbindung wurde unterbrochen, bevor der Vorgang abgeschlossen war. Prüfe, ob der Schlüssel fest im USB-C-Anschluss sitzt, und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión de la tarjeta se cortó antes de que terminara la operación. Comprueba que la clave esté bien insertada en el puerto USB-C e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion à la carte a été interrompue avant la fin de l'opération. Vérifiez que la clé est bien enfoncée dans le port USB-C et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作が完了する前にカード接続が切れました。キーがUSB-Cポートにしっかり挿さっているか確認して再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업이 끝나기 전에 카드 연결이 끊겼습니다. 키가 USB-C 포트에 단단히 꽂혀 있는지 확인하고 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão com o cartão caiu antes de a operação terminar. Verifique se a chave está firme na porta USB-C e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение с картой прервалось до завершения операции. Убедитесь, что ключ надежно вставлен в порт USB-C, и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作完成前卡的连接已中断。请检查密钥已牢固插入 USB-C 接口后重试。"
          }
        }
      }
    },
    "The card connection dropped before the operation finished. Hold your key steady against the top of your iPhone and tap to try again." : {
      "comment" : "Error message displayed when the connection to the card is lost.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kartenverbindung wurde unterbrochen, bevor der Vorgang abgeschlossen war. Halte deinen Schlüssel ruhig an die Oberseite deines iPhones und lege ihn auf, um es erneut zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión de la tarjeta se cortó antes de que terminara la operación. Mantén tu clave firme contra la parte superior de tu iPhone y acércala para volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
