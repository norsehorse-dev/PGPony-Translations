    "RSA 2048-bit. Widely compatible but slower. Good for compatibility with older systems." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 2048 Bit. Weit verbreitet, aber langsamer. Gut für Kompatibilität mit älteren Systemen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 2048-bit. Widely compatible but slower. Good for compatibility with older systems."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA de 2048 bits. Muy compatible pero más lenta. Buena para compatibilidad con sistemas antiguos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 2048 bits. Largement compatible mais plus lente. Adaptée pour la compatibilité avec d'anciens systèmes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 2048 ビット。互換性は高いものの動作が遅めです。古いシステムとの互換性に向いています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 2048비트. 널리 호환되지만 느립니다. 오래된 시스템과의 호환에 좋습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA de 2048 bits. Amplamente compatível, mas mais lenta. Boa para compatibilidade com sistemas antigos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 2048-bit. Широко совместим, но работает медленнее. Подходит для совместимости со старыми системами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RSA 2048 位。兼容性广但较慢。适合与较老的系统兼容。"
          }
        }
      }
    },
