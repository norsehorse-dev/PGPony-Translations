    "Verify a clear-signed PGP message against the keys in your keyring." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft eine klartextsignierte PGP-Nachricht anhand der Schlüssel in Ihrem Schlüsselbund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica un mensaje PGP con firma en claro con las claves de tu llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie un message PGP en signature claire avec les clés de votre trousseau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリア署名された PGP メッセージをキーリング内の鍵で検証します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반 텍스트 서명 PGP 메시지를 키링의 키와 대조해 검증합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
