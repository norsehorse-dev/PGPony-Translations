    "Didn't find what you needed? Tap Send Feedback in Settings to email the developer directly." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht gefunden, was du gesucht hast? Tippe in den Einstellungen auf „Feedback senden“, um direkt eine E-Mail an die Entwickler zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Didn't find what you needed? Tap Send Feedback in Settings to email the developer directly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿No encuentras lo que necesitas? Toca Enviar comentarios en Ajustes para escribir directamente al desarrollador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n'avez pas trouvé ce dont vous avez besoin ? Touchez Envoyer un commentaire dans les Réglages pour écrire directement au développeur."
