        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cifra y descifra cualquier tipo de archivo: documentos, fotos, archivos comprimidos. Comparte archivos cifrados de forma segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiffrez et déchiffrez tout type de fichier — documents, photos, archives. Partagez vos fichiers chiffrés en toute sécurité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドキュメント、写真、アーカイブなど、あらゆる形式のファイルを暗号化・復号できます。暗号化ファイルを安全に共有しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 파일 형식을 암호화하고 복호화하세요 — 문서, 사진, 압축 파일. 암호화된 파일을 안전하게 공유하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criptografe e descriptografe qualquer tipo de arquivo — documentos, fotos, compactados. Compartilhe arquivos cifrados com segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шифруйте и расшифровывайте файлы любого типа: документы, фото, архивы. Безопасно делитесь зашифрованными файлами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密和解密任意类型的文件——文档、照片、压缩包。安全地分享加密文件。"
          }
        }
      }
    },
