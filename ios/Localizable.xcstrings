    "Publish your public key to keys.openpgp.org so anyone can find and encrypt messages to you." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veröffentliche deinen öffentlichen Schlüssel auf keys.openpgp.org, damit andere ihn finden und dir verschlüsselte Nachrichten senden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
