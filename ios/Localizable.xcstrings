    "This key is protected. Enter its passphrase so PGPony can verify the backup will open in GnuPG and other OpenPGP apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Schlüssel ist geschützt. Gib seine Passphrase ein, damit PGPony prüfen kann, dass sich das Backup in GnuPG und anderen OpenPGP-Apps öffnen lässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This key is protected. Enter its passphrase so PGPony can verify the backup will open in GnuPG and other OpenPGP apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta clave está protegida. Introduce su frase de contraseña para que PGPony pueda verificar que la copia de seguridad se abrirá en GnuPG y otras apps OpenPGP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette clé est protégée. Saisissez sa phrase secrète pour que PGPony puisse vérifier que la sauvegarde s'ouvrira dans GnuPG et d'autres apps OpenPGP."
          }
        },
        "ja" : {
          "stringUnit" : {
