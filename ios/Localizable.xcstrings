          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отдельная подпись сохраняется рядом с оригиналом. Передайте оба файла, чтобы получатель мог выполнить проверку."
          }
        },
        "zh-Hans" : {
