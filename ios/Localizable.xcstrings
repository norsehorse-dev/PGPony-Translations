          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復号のたびにこのパスフレーズが必要です。忘れると、その鍵は永久にアクセスできなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복호화할 때마다 이 비밀구절이 필요합니다. 잊어버리면 키는 영구히 쓸 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
